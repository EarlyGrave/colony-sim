	"needs": {
		"_comment": "Trait needs: checked once per day by daily_needs(c, ctx); ctx keys are booleans the consumer fills. If `want` is false for `days` days in a row the thought `thought` is added (mood.json must define it).",
		"t_tunnel_rat": {"want": "mined_today", "days": 2, "thought": "no_tunnel"},
		"t_curious": {"want": "research_active", "days": 3, "thought": "nothing_new"},
		"t_dreamer": {"want": "letter_today", "days": 5, "thought": "no_letter"},
		"t_creature_of_habit": {"want": "same_job", "days": 1, "thought": "routine_broken"},
		"t_gallows_humor": {"want": "block_mate_alive", "days": 1, "thought": "no_audience"},
		"t_essence_hum": {"want": "near_essence", "days": 2, "thought": "hum_fades"}
	},
	"acquire": [
		{"trait": "t_hardened", "on": "rescued", "count": 1},
		{"trait": "t_resigned", "on": "despair_day", "count": 5, "reset_on": "despair_relief"},
